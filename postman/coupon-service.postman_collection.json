              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/redeem",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "redeem"
              ]
            }
          }
        },
        {
          "name": "Missing Idempotency-Key -> IDEMPOTENCY_KEY_REQUIRED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error code is IDEMPOTENCY_KEY_REQUIRED\", () => {",
