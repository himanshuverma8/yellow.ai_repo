{
  "info": {
    "name": "Coupon Redemption Service",
    "description": "Run the whole collection with the Collection Runner (in order). Needs the DB seeded: `npm run db:seed` (FLASH5, WELCOME10, REFER20, LASTONE, EXPIRED15).\nSet the `baseUrl` collection variable to match your PORT. Every run generates a fresh `runId` so ids never collide.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "futureDate",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"runId\")) pm.collectionVariables.set(\"runId\", Date.now().toString(36));",
          "pm.collectionVariables.set(\"futureDate\", new Date(Date.now() + 24 * 3600 * 1000).toISOString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "GET /health/db (DB check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"db connected\", () => { pm.expect(b.status).to.eql(\"ok\"); pm.expect(b.db).to.eql(\"connected\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/db",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "db"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Coupons",
      "item": [
        {
          "name": "GET seeded coupon FLASH5",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"has counters, remaining = max - redeemed\", () => {",
                  "  pm.expect(b).to.have.keys(\"redeemed_count\", \"remaining\", \"max_redemptions\");",
                  "  pm.expect(b.remaining).to.eql(b.max_redemptions - b.redeemed_count);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/coupons/FLASH5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "coupons",
                "FLASH5"
              ]
            }
          }
        },
        {
          "name": "POST create STACKABLE coupon (max 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"coupon created\", () => {",
                  "  pm.expect(b.code).to.eql(\"FLASH-\" + pm.collectionVariables.get(\"runId\").toUpperCase());",
                  "  pm.expect(b.max_redemptions).to.eql(1);",
                  "  pm.expect(b.redeemed_count).to.eql(0);",
                  "  pm.expect(b.type).to.eql(\"STACKABLE\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"FLASH-{{runId}}\",\n  \"max_redemptions\": 1,\n  \"discount_percent\": 30,\n  \"expires_at\": \"{{futureDate}}\",\n  \"type\": \"STACKABLE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "coupons"
              ]
            }
          }
        },
        {
          "name": "POST create STANDARD coupon (max 10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"STD-{{runId}}\",\n  \"max_redemptions\": 10,\n  \"discount_percent\": 15,\n  \"expires_at\": \"{{futureDate}}\",\n  \"type\": \"STANDARD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "coupons"
              ]
            }
          }
        },
        {
          "name": "POST duplicate code -> COUPON_ALREADY_EXISTS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"error code is COUPON_ALREADY_EXISTS\", () => {",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e.code).to.eql(\"COUPON_ALREADY_EXISTS\");",
                  "  pm.expect(e.type).to.eql(\"CONFLICT\");",
                  "  pm.expect(e.description).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"FLASH-{{runId}}\",\n  \"max_redemptions\": 1,\n  \"discount_percent\": 30,\n  \"expires_at\": \"{{futureDate}}\",\n  \"type\": \"STACKABLE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "coupons"
              ]
            }
          }
        },
        {
          "name": "POST invalid body -> VALIDATION_ERROR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error code is VALIDATION_ERROR\", () => {",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e.code).to.eql(\"VALIDATION_ERROR\");",
                  "  pm.expect(e.type).to.eql(\"VALIDATION\");",
                  "  pm.expect(e.description).to.be.a(\"string\");",
                  "});",
                  "pm.test(\"lists every bad field\", () => pm.expect(pm.response.json().error.details).to.have.length(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"code\": \"bad code!\", \"max_redemptions\": 0, \"discount_percent\": 101, \"expires_at\": \"nope\", \"type\": \"X\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "coupons"
              ]
            }
          }
        },
        {
          "name": "GET unknown coupon -> COUPON_NOT_FOUND",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"error code is COUPON_NOT_FOUND\", () => {",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e.code).to.eql(\"COUPON_NOT_FOUND\");",
                  "  pm.expect(e.type).to.eql(\"NOT_FOUND\");",
                  "  pm.expect(e.description).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/coupons/DOESNOTEXIST",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "coupons",
                "DOESNOTEXIST"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Redeem",
      "item": [
        {
          "name": "Redeem WELCOME10 (customer A, order 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"success true\", () => {",
                  "  pm.expect(b.success).to.eql(true);",
                  "  pm.expect(b.remaining).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "key-{{runId}}-1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"WELCOME10\",\n  \"customer_id\": \"cust-{{runId}}-a\",\n  \"order_id\": \"ord-{{runId}}-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/redeem",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "redeem"
              ]
            }
          }
        },
        {
          "name": "Retry same Idempotency-Key -> replayed, not double-redeemed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"success true\", () => {",
                  "  pm.expect(b.success).to.eql(true);",
                  "  pm.expect(b.remaining).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"flagged as replay\", () => pm.response.to.have.header(\"Idempotent-Replayed\", \"true\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "key-{{runId}}-1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"WELCOME10\",\n  \"customer_id\": \"cust-{{runId}}-a\",\n  \"order_id\": \"ord-{{runId}}-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/redeem",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "redeem"
              ]
            }
          }
        },
        {
          "name": "Same key, different payload -> IDEMPOTENCY_KEY_REUSED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"error code is IDEMPOTENCY_KEY_REUSED\", () => {",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e.code).to.eql(\"IDEMPOTENCY_KEY_REUSED\");",
                  "  pm.expect(e.type).to.eql(\"BUSINESS_RULE\");",
                  "  pm.expect(e.description).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "key-{{runId}}-1"
              }
            ],
            "body": {
              "mode": "raw",
